{
  "name": "services-marketplace-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "migrate:down": "node scripts/run-migrations.mjs down",
    "migrate:up": "node scripts/run-migrations.mjs up",
    "validate:plan": "node scripts/validate-plan.mjs",
    "validate:static": "node scripts/check-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:plan && npm run validate:static && npm run generate:sdk:check && npm run build && npm test",
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:sdk:check": "node scripts/generate-sdk.mjs --check"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
