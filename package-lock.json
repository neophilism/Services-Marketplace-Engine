{
  "name": "services-marketplace-engine",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "services-marketplace-engine",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "5.7.3"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@services-marketplace/api",
      "version": "0.0.0",
      "dependencies": {
        "@services-marketplace/contracts": "0.0.0"
      }
    },
    "apps/worker": {
      "name": "@services-marketplace/worker",
      "version": "0.0.0",
      "dependencies": {
        "@services-marketplace/contracts": "0.0.0"
      }
    },
    "node_modules/@services-marketplace/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@services-marketplace/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@services-marketplace/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.7.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.7.3.tgz",
      "integrity": "sha512-84MVSjMEHP+FQRPy3pX9sTVV/INIex71s9TL2Gm5FG/WG1SqXeKyZ0k7/blY/4FdOzI12CBy1vGc4og/eus0fw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@services-marketplace/contracts",
      "version": "0.0.0"
    },
    "node_modules/@services-marketplace/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "packages/sdk": {
      "name": "@services-marketplace/sdk",
      "version": "0.0.0"
    }
  }
}
