{
  "openapi": "3.1.0",
  "info": {
    "title": "Services Marketplace Engine API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.invalid"
    }
  ],
  "paths": {
    "/v1/organizations/{organizationId}/resources/{resourceId}": {
      "get": {
        "operationId": "getResource",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "resourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "$ref": "#/components/parameters/ContractVersion"
          }
        ],
        "responses": {
          "200": {
            "description": "Resource visible to the authorized tenant member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported contract version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedContractVersion"
                }
              }
            }
          },
          "403": {
            "description": "Authorization denied without resource disclosure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationDenied"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ContractVersion": {
        "name": "X-Contract-Version",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "schemas": {
      "Resource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          }
        }
      },
      "UnsupportedContractVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "const": "unsupported_contract_version"
          }
        }
      },
      "AuthorizationDenied": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "const": "authorization_denied"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
